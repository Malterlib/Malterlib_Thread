Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Thread}"
{
	%Group "Thread"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Thread/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Thread true
	{
		&
		{
			MalterlibLibrary_Thread ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Thread;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Thread true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Thread true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Thread true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Thread;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Thread "@('Test/*'->MakeAbsolute())"
}

