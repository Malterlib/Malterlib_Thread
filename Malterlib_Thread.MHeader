Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Thread}"
{
	%Group "Thread"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Thread/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Thread define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Thread"
	{
		!!MalterlibLibrary_Thread true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Thread define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Thread true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Thread"
	MalterlibTestFiles_Malterlib_Thread define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

