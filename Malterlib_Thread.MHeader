Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Thread}"
{
	%Group "Thread"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Thread/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Thread: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Thread"
	{
		!!MalterlibLibrary_Thread true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Thread: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Thread true
	}

	MalterlibThread_DebugThreadLocals: bool = false // User(Debug)=true: Enable debug support to detect thread local leaks.
}

%Target "Dll_Test_Malterlib_Helper_Thread"
{
	Property
	{
		MalterlibHelperTest true
		MalterlibPostCopyProject "Tests"
		ProductName "Malterlib Thread Test Dll"
	}
	Target
	{
		BaseName "Test_Malterlib_Helper_Thread"
		Type "DynamicLibrary"
		Group "Helpers"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
	}
	%File "TestHelper/Test_Malterlib_Thread_DllMain.cpp"
	%Dependency "Lib_Malterlib"
}

%Target "Com_Test_Malterlib_Helper_Thread_NonMalterlibHost"
{
	Property
	{
		MalterlibDisableMalterlib true
		MalterlibEnableBreakpad false
		MalterlibHelperTest true
		MalterlibPostCopyProject "Tests"
		MalterlibTargetNameType "BaseName"
		ProductName "Malterlib Thread Non-Malterlib Host Test"
	}
	Target
	{
		BaseName "Test_Malterlib_Helper_Thread_NonMalterlibHost"
		CharacterSet "MultiByte"
		{
			!!PlatformFamily "Windows"
		}
		Type "ConsoleExecutable"
		Group "Helpers"
		LDFlags =+ "-nostdlib++"
		{
			!PlatformFamily "Windows"
		}
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
		DefaultHeaders "NoStdIncludeCxx"
		DefaultLibraries "NoStdLibCxx"
	}
	%File "TestHelper/Test_Malterlib_Thread_NonMalterlibHost.c"
}

%Group "{Test}/{Malterlib_Thread}"
{
	%Dependency "Dll_Test_Malterlib_Helper_Thread"
	{
		Dependency.Link false
		Dependency.Stage "Runtime"
	}
	%Dependency "Com_Test_Malterlib_Helper_Thread_NonMalterlibHost"
	{
		Dependency.Link false
		Dependency.Stage "Runtime"
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	MalterlibLibrary_Process true

	MalterlibTests =+ "Malterlib_Thread"
	MalterlibTestFiles_Malterlib_Thread: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestExtraGroups_Malterlib_Thread: [string] = ["{Test}/{Malterlib_Thread}"]
}
